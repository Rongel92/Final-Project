# Server configuration
PORT=4000
# PostgreSQL connection string. Prisma and the session store (connect-pg-simple)
# both read this. The value below matches the local database started with:
#   docker compose -f docker-compose.dev.yml up -d
DATABASE_URL="postgresql://resale:resale@localhost:5432/laptop_resale?schema=public"
# Comma-separated list of allowed CORS origins for the frontend
CLIENT_ORIGIN="http://localhost:5173"
# Directory (relative to server root) where laptop model images are stored
UPLOAD_DIR="uploads"
# Max upload size in bytes (10 MB)
MAX_UPLOAD_BYTES=10485760

# --- Session ---
# Random long string; used to sign the session cookie. REQUIRED in production.
SESSION_SECRET="change-me-to-a-long-random-string"
# Send the session cookie only over HTTPS (set true in production/behind TLS).
COOKIE_SECURE=false
# Set true when running behind a reverse proxy (so secure cookies work).
TRUST_PROXY=false

# --- Sign-in ---
# There is no SSO: the sign-in page lists the active users in the database and
# you pick one. Load the demo users and data with `npm run seed`.

# Email delivery. transport 'graph' sends via Microsoft Graph app-only using the
# Entra app registration below (needs Mail.Send application permission + an
# Application Access Policy scoping the app to the sender mailbox). Anything else
# logs only.
EMAIL_TRANSPORT="log"
EMAIL_FROM="laptop-resale@company.local"
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
