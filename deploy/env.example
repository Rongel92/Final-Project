# ============================================================================
# TEMPLATE for a container's runtime configuration. Copy to prod.env / test.env
# and fill in real values. The real *.env files are gitignored.
#
# Sign-in has no SSO: the sign-in page lists the active users in the database
# and you pick one.
# ============================================================================

# --- Public origin of this container -----------------------------------------
APP_URL=https://resale.company.local
CLIENT_ORIGIN=https://resale.company.local

# --- Cookie / proxy security -------------------------------------------------
# true for HTTPS behind a TLS-terminating reverse proxy; false for http://localhost.
COOKIE_SECURE=true
TRUST_PROXY=true

# --- Session ------------------------------------------------------------------
# Generate a long random value, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Outbound egress proxy for Microsoft Graph email. Set by the platform; the app
# honors these automatically (services/http.ts). Leave unset for direct egress.
# HTTPS_PROXY=http://egress-proxy.internal:3128
# NO_PROXY=.cluster.local,.svc,localhost,127.0.0.1

# --- Microsoft Entra ID app registration (Graph email) -----------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Email (Microsoft Graph app-only) ----------------------------------------
EMAIL_TRANSPORT=graph
EMAIL_FROM=laptop-resale@company.local
